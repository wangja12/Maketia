# PostgreSQL de l'application
DATABASE_URL=postgresql://app:app@localhost:5432/tunnels
# Base dédiée aux tests (vidée à chaque exécution)
TEST_DATABASE_URL=postgresql://app:app@localhost:5432/tunnels_test
# URL publique, utilisée pour afficher l'adresse du serveur MCP (facultatif en local)
# APP_URL=https://app.exemple.com
# Publication : les tunnels sont servis sur <sous-domaine>.PUBLIC_ROOT_DOMAIN (DNS générique *.domaine requis)
# PUBLIC_ROOT_DOMAIN=tunnels.exemple.com
# Cible CNAME donnée aux clients pour leurs domaines personnalisés
# PUBLIC_DOMAIN_TARGET=cname.tunnels.exemple.com
# Chiffrement des secrets stockés (secret de webhook SasPay) (32 octets en base64 : openssl rand -base64 32)
# PAYMENT_SECRETS_KEY=
# Mesure d'audience interne : clé de signature des jetons de vue (32 caractères minimum : openssl rand -base64 48).
# Absente = visites et clics non mesurés (les paiements confirmés restent comptés).
# ANALYTICS_SECRET=
# Fichiers privés des produits numériques (disque persistant, hors de tout dossier public). Défaut : .data/files
# FILES_DIR=/var/lib/tunnels/files
